{
  "name": "omochi-tune",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs dist 4173",
    "mcp": "node mcp/server.mjs",
    "mcp:build": "node scripts/build-mcp.mjs",
    "mcp:http": "node mcp/server.mjs --transport http",
    "test:mcp": "npm run mcp:build && node --test tests/mcp.test.mjs",
    "test": "npm run test:mcp && npm run build && playwright test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
